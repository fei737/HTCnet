*.log

# ---------- 模型权重 ----------
*.pth
*.pt
*.ckpt
*.pkl
*.onnx
*.safetensors
*.bin

# ---------- Python 缓存 / 构建 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# ---------- 编辑器 / 工具 / 环境 ----------
