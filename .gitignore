DataSets/
dataset/
datasets/
NYURGB/
HHA_datasets/
labels/
getDATA/Depth2HHA-python/
**/data/
*.npy
*.npz
*.mat
*.h5
*.hdf5

# ---------- 训练输出 / 实验结果 ----------
runs/
runs_ugf_lite/
ablation_runs/
ablation_runs_mitb2_clean/
Checkpoint/
Checkpoint_DGRQ_simple_mlp/
checkpoints/
results/
result_*.png
logs/
